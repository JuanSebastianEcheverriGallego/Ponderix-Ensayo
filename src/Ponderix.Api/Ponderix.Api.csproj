<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ponderix.Api</RootNamespace>
    <AssemblyName>Ponderix.Api</AssemblyName>
    <!-- Cualquier advertencia del compilador detiene la CI: la validación es estricta. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
